# Example environment for a second SignalHub/P7 Scanner stack.
# Copy to .env.peer locally, or paste these variables into a second
# Portainer stack that uses docker-compose.peer.yml.

COMPOSE_PROJECT_NAME=p7scanner-peer
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=signalforge-org
IMAGE_TAG=latest

# Use a different exposed client port than your main stack.
CLIENT_PORT=3001

# Give the peer stack its own database identity/password.
POSTGRES_DB=p7scanner_peer
POSTGRES_USER=p7scanner
POSTGRES_PASSWORD=change-me-peer-strong

APP_ENV=production
STACK_ID=peer-stack
# Optional override; leave blank to report IMAGE_TAG as the deployed tag.
DEPLOY_TAG=
LOG_LEVEL=info

# Set this to the public URL/subdomain for the second hub.
# Example: https://p7peer.projectseven.us
APP_BASE_URL=https://peer.example.com
HUB_PUBLIC_URL=https://peer.example.com
HUB_NAME=P7 Scanner Peer Hub
HUB_REGION=Peer Test
HUB_CONTACT=
HUB_FEDERATION_ENABLED=true
HUB_TRUST_LEVEL=community
HUB_TRUST_ISSUER=
HUB_TRUST_CERTIFICATE=
HUB_TRUST_EXPIRES_AT=0
HUB_DIRECTORY_URL=https://signalforge.org/directory/hubs.json
UPDATE_CHECK_URL=https://signalforge.org/p7-scanner-update.json

# Password auth (recommended for peer/off-grid testing). Set in Portainer stack env
# or here in .env.peer. Use a different bootstrap email/password than the main hub.
AUTH_BOOTSTRAP_EMAIL=admin@peer.local.signalforge
AUTH_BOOTSTRAP_PASSWORD=change-me-peer-strong
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_AUTO_APPROVE_USERS=true
# If a password contains $, escape it as $$ for Docker Compose interpolation.

# Optional transcription worker (same token on api + transcriber; blank disables queueing).
TRANSCRIPTION_WORKER_TOKEN=
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_POLL_SECONDS=2
TRANSCRIPTION_MIN_DURATION_SECONDS=0.75
TRANSCRIPTION_CPU_THREADS=0
HF_TOKEN=

# Optional magic-link email. Leave blank for password-only peer testing.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=SignalForge Peer Hub
