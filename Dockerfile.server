FROM golang:1.25-alpine AS builder
ARG GIT_SHA=unknown
ARG BUILD_VERSION=
ARG BUILD_DATE=unknown
WORKDIR /app
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server ./
RUN sh b

FROM alpine:3.20
RUN apk add --no-cache ffmpeg ca-certificates su-exec \
	&& addgroup -S app \
	&& adduser -S -G app -u 10001 app
WORKDIR /app
COPY --from=builder /out/server /usr/local/bin/p7-scanner-server
COPY docker/server-entrypoint.sh /usr/local/bin/server-entrypoint.sh
RUN chmod +x /usr/local/bin/server-entrypoint.sh
EXPOSE 8080
ENTRYPOINT ["server-entrypoint.sh"]
CMD ["p7-scanner-server"]
