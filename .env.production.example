# Required prebuilt image coordinates
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=signalforge-org
IMAGE_TAG=latest
# Optional: set full image refs to bypass registry/namespace/tag interpolation.
# API_IMAGE=ghcr.io/signalforge-org/signalforge-hub-api:latest
# WEB_IMAGE=ghcr.io/signalforge-org/signalforge-hub-web:latest
# MOCK_CALL_SENDER_IMAGE=ghcr.io/signalforge-org/signalforge-hub-mock-call-sender:latest
# TRANSCRIBER_IMAGE=ghcr.io/signalforge-org/signalforge-hub-transcriber:latest
STACK_ID=signalforge-hub
# Optional override; defaults to IMAGE_TAG when not set.
# DEPLOY_TAG=latest

# Runtime config
APP_ENV=production
LOG_LEVEL=info
APP_BASE_URL=https://scanner.example.com
UPDATE_CHECK_URL=https://signalforge.org/p7-scanner-update.json

# Optional local transcription worker. Generate a strong random token and run
# compose with --profile transcription to enable the worker container.
TRANSCRIPTION_WORKER_TOKEN=
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_POLL_SECONDS=2
# Optional Hugging Face token for faster model downloads and higher rate limits.
HF_TOKEN=

# SignalHub federation. Set HUB_FEDERATION_ENABLED=true on hubs that should
# create/accept peer invites and publish explicitly shared sources.
HUB_NAME=SignalForge Hub
HUB_PUBLIC_URL=https://scanner.example.com
HUB_REGION=
HUB_CONTACT=
HUB_FEDERATION_ENABLED=false
HUB_TRUST_LEVEL=community
HUB_TRUST_ISSUER=
HUB_TRUST_CERTIFICATE=
HUB_TRUST_EXPIRES_AT=0
HUB_DIRECTORY_URL=https://signalforge.org/directory/hubs.json

# Magic-link email delivery (Mailjet)
# Mailjet is configured with API credentials, not a separate URL/link.
# Get these from your Mailjet account settings/dashboard.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=no-reply@scanner.example.com
MAIL_FROM_NAME=SignalForge Hub

# SCANNER_URL is the mock sender target; APP_BASE_URL is for auth email links.
SCANNER_URL=https://scanner.example.com

# Leave DATABASE_URL blank to use the bundled postgres service below, or set a full external DSN.
# DATABASE_URL=postgres://db_user:db_password@db_host:5432/p7scanner?sslmode=require

# Bundled postgres service defaults.
POSTGRES_DB=p7scanner
POSTGRES_USER=p7scanner
# Required in real deployments. Keep strong and non-default.
POSTGRES_PASSWORD=change-me-strong

# Host ports
SERVER_PORT=8080
CLIENT_PORT=3000

# Mock call sender (only used with --profile mock)
MOCK_INTERVAL_SEC=5
MOCK_DURATION_SEC=3
MOCK_SYSTEM_ID=1
MOCK_SYSTEM_LABEL=Mock P25 System
MOCK_FREQUENCY=460000000
MOCK_SOURCE_API_KEY=
