# Required prebuilt image coordinates
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=signalforge-org
IMAGE_TAG=latest
# Optional: set full image refs to bypass registry/namespace/tag interpolation.
# API_IMAGE=ghcr.io/signalforge-org/signalforge-hub-api:latest
# WEB_IMAGE=ghcr.io/signalforge-org/signalforge-hub-web:latest
# MOCK_CALL_SENDER_IMAGE=ghcr.io/signalforge-org/signalforge-hub-mock-call-sender:latest
# TRANSCRIBER_IMAGE=ghcr.io/signalforge-org/signalforge-hub-transcriber:latest
STACK_ID=signalforge-hub
# Optional override; defaults to IMAGE_TAG when not set.
# DEPLOY_TAG=latest

# Runtime config
APP_ENV=production
LOG_LEVEL=info
APP_BASE_URL=https://scanner.example.com
UPDATE_CHECK_URL=https://signalforge.org/p7-scanner-update.json

# Optional local transcription worker. Generate a strong random token and set the
# same value on api + transcriber. Leave blank to disable queueing in the call log.
# docker-compose.prod.yml uses --profile transcription; docker-compose.plesk.yml
# includes the transcriber service by default.
TRANSCRIPTION_WORKER_TOKEN=
TRANSCRIPTION_MODEL=base
TRANSCRIPTION_DEVICE=cpu
TRANSCRIPTION_COMPUTE_TYPE=int8
TRANSCRIPTION_LANGUAGE=
TRANSCRIPTION_POLL_SECONDS=2
TRANSCRIPTION_MIN_DURATION_SECONDS=0.75
TRANSCRIPTION_CPU_THREADS=0
# Optional Hugging Face token for faster model downloads and higher rate limits.
HF_TOKEN=

# SignalHub federation. Set HUB_FEDERATION_ENABLED=true on hubs that should
# create/accept peer invites and publish explicitly shared sources.
HUB_NAME=SignalForge Hub
HUB_PUBLIC_URL=https://scanner.example.com
HUB_REGION=
HUB_CONTACT=
HUB_FEDERATION_ENABLED=false
HUB_TRUST_LEVEL=community
HUB_TRUST_ISSUER=
HUB_TRUST_CERTIFICATE=
HUB_TRUST_EXPIRES_AT=0
HUB_DIRECTORY_URL=https://signalforge.org/directory/hubs.json

# Off-grid / closed-cell auth (optional — use instead of or alongside Mailjet)
# Set these in Portainer/Plesk stack Environment variables, OR save as .env.production on the server.
# AUTH_BOOTSTRAP_PASSWORD is required — without it login stays off and no admin is created.
AUTH_BOOTSTRAP_EMAIL=admin@local.signalforge
AUTH_BOOTSTRAP_PASSWORD=change-me-strong
AUTH_PASSWORD_LOGIN_ENABLED=true
AUTH_AUTO_APPROVE_USERS=true
# If a password contains $, escape it as $$ for Docker Compose interpolation.

# Magic-link email delivery (Mailjet)
# Mailjet is configured with API credentials, not a separate URL/link.
# Get these from your Mailjet account settings/dashboard.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=no-reply@scanner.example.com
MAIL_FROM_NAME=SignalForge Hub

# SCANNER_URL is the mock sender target; APP_BASE_URL is for auth email links.
SCANNER_URL=https://scanner.example.com

# Leave DATABASE_URL blank to use the bundled postgres service below, or set a full external DSN.
# DATABASE_URL=postgres://db_user:db_password@db_host:5432/p7scanner?sslmode=require

# Bundled postgres service defaults.
POSTGRES_DB=p7scanner
POSTGRES_USER=p7scanner
# Required in real deployments. Keep strong and non-default.
POSTGRES_PASSWORD=change-me-strong

# Host ports
SERVER_PORT=8080
CLIENT_PORT=3000

# Call retention — export audio to disk then delete from Postgres to control DB growth.
# Optional: sync day folders to DigitalOcean Spaces (S3-compatible) via s3cmd.
# https://docs.digitalocean.com/products/spaces/reference/s3cmd/
CALL_RETENTION_DAYS=30
CALL_ARCHIVE_DIR=/data/call-archive
# s3://your-space-name/signalforge-hub/call-archive
CALL_ARCHIVE_S3_URI=
CALL_ARCHIVE_S3CFG=/etc/signalforge/s3cfg
CALL_ARCHIVE_DELETE_LOCAL_AFTER_S3=true
# Or mount a pre-made s3cfg file and omit these:
# SPACES_ACCESS_KEY=
# SPACES_SECRET_KEY=
# SPACES_ENDPOINT=nyc3.digitaloceanspaces.com

# Mock call sender (only used with --profile mock)
MOCK_INTERVAL_SEC=5
MOCK_DURATION_SEC=3
MOCK_SYSTEM_ID=1
MOCK_SYSTEM_LABEL=Mock P25 System
MOCK_FREQUENCY=460000000
MOCK_SOURCE_API_KEY=

# Optional SignalForge Discord bot — starts with the hub stack (no COMPOSE_PROFILES).
# Without DISCORD_TOKEN the container idles until secrets are set. Source: deploy/discord-bot/
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
WELCOME_CHANNEL_ID=
# Optional overrides (defaults point at production SignalForge URLs + this hub's public URL):
# DIRECTORY_FEED_URL=https://signalforge.org/directory/hubs.json
# HOSTED_HUB_URL=https://p7hub.projectseven.us
# SITE_URL=https://signalforge.org
# DISCORD_BOT_IMAGE=signalforge-discord-bot:local
# DISCORD_BOT_TAG=local
